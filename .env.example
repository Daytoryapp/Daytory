# ─── Kakao ────────────────────────────────────────────────────────────────────
# 카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키 → 네이티브 앱 키
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase 프로젝트 → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
